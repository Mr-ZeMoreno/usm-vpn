#!/usr/bin/env python3
# usm-vpn — cliente SSLVPN multiplataforma para la VPN de la USM (WatchGuard/OpenVPN + SAML).
# Mac / Linux / Windows.  Sin datos personales: cada quien usa SU propio perfil y certificados.
#   usm-vpn setup        prepara el perfil (localiza tu WatchGuard o pasa --profile / --openvpn)
#   usm-vpn connect      login SAML (pegar URL; o --gui en Mac) y levanta el tunel
#   usm-vpn disconnect   cierra el tunel de forma limpia
#   usm-vpn status       muestra si estas conectado
#   usm-vpn info         muestra la configuracion y notas por SO
import os, sys, re, json, time, shutil, signal, subprocess, platform, webbrowser, urllib.parse
from pathlib import Path

HOME = Path.home()
RT   = HOME / ".usm-vpn"          # runtime del usuario
PROF = RT / "profile"
RUN  = RT / "run"
CFG  = RT / "config.json"
DNSF = RUN / "dns.json"
LOG  = RUN / "openvpn.log"
PIDF = RUN / "openvpn.pid"
TOKRE = re.compile(r'_[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}')
IS_WIN = platform.system() == "Windows"
IS_MAC = platform.system() == "Darwin"
DEFAULT_SERVER = "accede.usm.cl"

def die(msg, code=1):
    print(f"❌ {msg}"); sys.exit(code)

def load_cfg():
    if not CFG.exists(): die("No hay configuracion. Ejecuta primero:  usm-vpn setup")
    return json.loads(CFG.read_text())

# ---------------- SETUP ----------------
def find_profile_dir():
    cands = []
    if IS_MAC:  cands.append(HOME / "Library/WatchGuard/Mobile VPN")
    if IS_WIN:  cands.append(Path(os.environ.get("USERPROFILE", HOME)) / "AppData/Roaming/WatchGuard/Mobile VPN")
    cands += [HOME / ".watchguard", HOME / "WatchGuard"]
    for c in cands:
        if c.exists() and any(c.glob("*.ovpn")):
            return c
    return None

WG_OPENVPN = "/Applications/WatchGuard/WatchGuard Mobile VPN with SSL.app/Contents/Resources/openvpn"

def find_openvpn():
    # 1) standalone en el PATH
    p = shutil.which("openvpn")
    if p: return p
    # 2) rutas comunes de instalacion propia (brew suele ser keg-only, no en el PATH)
    for c in ["/opt/homebrew/sbin/openvpn", "/opt/homebrew/bin/openvpn",
              "/usr/local/sbin/openvpn", "/usr/local/bin/openvpn", "/usr/sbin/openvpn"]:
        if Path(c).exists(): return c
    if IS_WIN:
        for g in [r"C:\Program Files\OpenVPN\bin\openvpn.exe"]:
            if Path(g).exists(): return g
    # 3) ultimo recurso: el openvpn que trae WatchGuard (dependencia a evitar)
    if IS_MAC and Path(WG_OPENVPN).exists(): return WG_OPENVPN
    if IS_WIN:
        wg = r"C:\Program Files\WatchGuard\WatchGuard Mobile VPN with SSL\openvpn.exe"
        if Path(wg).exists(): return wg
    return None

def parse_refs(ovpn_text):
    refs = []
    for key in ("ca", "cert", "key", "tls-auth", "tls-crypt"):
        m = re.search(rf'^\s*{key}\s+(\S+)', ovpn_text, re.M)
        if m and not m.group(1).startswith("["):
            refs.append(m.group(1))
    return refs

def download_profile(server, use_gui, insecure=False):
    import io, tarfile, ssl, urllib.request
    print(">> Para descargar tu perfil necesito tu login SAML (es tu cuenta USM).")
    user, tok = (get_token_gui if use_gui else get_token_paste)(server)
    if not (user and tok): die("No obtuve token; no puedo descargar el perfil.")
    fw_user = urllib.parse.quote("Entra_ID_SAML\\" + user)
    url = (f"https://{server}/?action=sslvpn_download&filename=client.wgssl"
           f"&fw_password={urllib.parse.quote(tok)}&fw_username={fw_user}")
    print(">> Descargando perfil del Firebox...")
    ctx = ssl._create_unverified_context() if insecure else ssl.create_default_context()
    try:
        data = urllib.request.urlopen(url, timeout=30, context=ctx).read()
    except ssl.SSLError:
        die("El portal presenta un certificado no verificable. Si confias en la red, "
            "reintenta:  usm-vpn setup --download --insecure")
    if len(data) < 200 or data[:15].lstrip().startswith(b"<"):
        die("La descarga no parece un perfil (¿token vencido o usuario incorrecto?). Reintenta.")
    # extraer el paquete (tgz/tar) en PROF
    ok = False
    try:
        with tarfile.open(fileobj=io.BytesIO(data), mode="r:*") as tf:
            tf.extractall(PROF); ok = True
    except Exception: ok = False
    if ok:  # aplanar si quedo en subcarpeta
        for f in list(PROF.rglob("*")):
            if f.is_file() and f.suffix in (".ovpn",".crt",".pem",".key") and f.parent != PROF:
                shutil.move(str(f), str(PROF / f.name))
    ov = list(PROF.glob("*.ovpn"))
    if not ov:
        die("No pude extraer un .ovpn del paquete. Descarga el perfil del portal a mano "
            "y usa:  usm-vpn setup --profile <ruta>")
    if ov[0].name != "client.ovpn":
        shutil.move(str(ov[0]), str(PROF / "client.ovpn"))
    print(">> Perfil descargado y extraido en", PROF)

# ---------------- DNS interno (set en connect, restore en disconnect) ----------------
def _pushed_dns(log_text):
    return sorted(set(re.findall(r"dhcp-option DNS ([0-9.]+)", log_text)))

def _mac_service():
    dev = ""
    try:
        out = subprocess.run(["route","-n","get","default"],capture_output=True,text=True).stdout
        m = re.search(r"interface:\s*(\S+)", out); dev = m.group(1) if m else ""
    except Exception: pass
    try:
        order = subprocess.run(["networksetup","-listnetworkserviceorder"],capture_output=True,text=True).stdout
        for m in re.finditer(r"\(\d+\)\s*(.+?)\n\(Hardware Port:.*?Device:\s*(\w+)\)", order):
            if m.group(2) == dev: return m.group(1).strip()
    except Exception: pass
    return "Wi-Fi"

def _linux_tun_iface(sample_ip):
    try:
        out = subprocess.run(["ip","route","get",sample_ip],capture_output=True,text=True).stdout
        m = re.search(r"dev\s+(\S+)", out)
        if m: return m.group(1)
    except Exception: pass
    return None

def dns_set(dns):
    """Aplica los DNS del VPN y guarda el estado para restaurar luego."""
    if not dns or IS_WIN:   # Windows: openvpn aplica dhcp-option DNS por su cuenta
        return
    if IS_MAC:
        svc = _mac_service()
        if DNSF.exists():                     # reconexion tras caida: conservar el original real
            try: saved = json.loads(DNSF.read_text()).get("saved", [])
            except Exception: saved = []
        else:
            cur = subprocess.run(["networksetup","-getdnsservers",svc],capture_output=True,text=True).stdout.strip()
            saved = [] if "aren't any" in cur else cur.split()
        DNSF.write_text(json.dumps({"os":"mac","service":svc,"saved":saved}))
        subprocess.run(["sudo","networksetup","-setdnsservers",svc]+dns)
        subprocess.run(["sudo","dscacheutil","-flushcache"],stderr=subprocess.DEVNULL)
        subprocess.run(["sudo","killall","-HUP","mDNSResponder"],stderr=subprocess.DEVNULL)
        print(f">> DNS -> {' '.join(dns)} (en {svc}; se restaura al desconectar)")
    else:  # Linux
        iface = _linux_tun_iface(dns[0])
        if shutil.which("resolvectl") and iface:
            DNSF.write_text(json.dumps({"os":"linux","method":"resolvectl","iface":iface}))
            subprocess.run(["sudo","resolvectl","dns",iface]+dns)
            subprocess.run(["sudo","resolvectl","domain",iface,"~."])  # todas las consultas por el VPN
            print(f">> DNS -> {' '.join(dns)} (via resolvectl en {iface})")
        else:
            rc = pathlib.Path("/etc/resolv.conf")
            try:
                bak = rc.read_text()
                DNSF.write_text(json.dumps({"os":"linux","method":"resolvconf","backup":bak}))
                new = "".join(f"nameserver {d}\n" for d in dns)
                subprocess.run(["sudo","cp","/etc/resolv.conf","/etc/resolv.conf.usmvpn.bak"])
                subprocess.run(["sudo","tee","/etc/resolv.conf"],input=new,text=True,stdout=subprocess.DEVNULL)
                print(f">> DNS -> {' '.join(dns)} (/etc/resolv.conf; respaldo guardado)")
            except Exception as e:
                print("   (no pude fijar DNS automaticamente:", e, ")")

def dns_restore():
    if not DNSF.exists(): return
    try: st = json.loads(DNSF.read_text())
    except Exception: st = {}
    try:
        if st.get("os") == "mac":
            svc = st.get("service","Wi-Fi"); saved = st.get("saved") or []
            subprocess.run(["sudo","networksetup","-setdnsservers",svc]+(saved if saved else ["Empty"]))
            subprocess.run(["sudo","dscacheutil","-flushcache"],stderr=subprocess.DEVNULL)
            subprocess.run(["sudo","killall","-HUP","mDNSResponder"],stderr=subprocess.DEVNULL)
            print(f">> DNS restaurado en {svc}: {' '.join(saved) if saved else 'DHCP'}")
        elif st.get("method") == "resolvectl":
            subprocess.run(["sudo","resolvectl","revert",st.get("iface","")])
            print(">> DNS restaurado (resolvectl revert)")
        elif st.get("method") == "resolvconf":
            subprocess.run(["sudo","cp","/etc/resolv.conf.usmvpn.bak","/etc/resolv.conf"])
            print(">> DNS restaurado (/etc/resolv.conf)")
    except Exception as e:
        print("   (aviso al restaurar DNS:", e, ")")
    try: DNSF.unlink()
    except Exception: pass

def cmd_setup(args):
    prof_arg = None; ovpn_arg = None; realm = "Entra_ID_SAML"
    server_arg = None; do_dl = False; use_gui = False; insecure = False
    it = iter(args)
    for a in it:
        if a == "--profile": prof_arg = next(it, None)
        elif a == "--openvpn": ovpn_arg = next(it, None)
        elif a == "--realm": realm = next(it, None)
        elif a == "--server": server_arg = next(it, None)
        elif a == "--download": do_dl = True
        elif a == "--gui": use_gui = True
        elif a == "--insecure": insecure = True
    PROF.mkdir(parents=True, exist_ok=True); RUN.mkdir(parents=True, exist_ok=True)
    # compilar el helper --gui si se puede (para poder usarlo en la descarga)
    if IS_MAC and use_gui and shutil.which("swiftc") and (RT/'saml-login.swift').exists() and not (RT/'saml-login').exists():
        try: subprocess.run(["swiftc","-O",str(RT/'saml-login.swift'),"-o",str(RT/'saml-login')],check=True)
        except Exception: pass

    if do_dl:
        download_profile(server_arg or DEFAULT_SERVER, use_gui, insecure)
        src_ovpn = PROF / "client.ovpn"; src_dir = PROF
    else:
        # localizar el .ovpn local (instalacion WatchGuard existente)
        src_ovpn = None; src_dir = None
        if prof_arg:
            p = Path(prof_arg).expanduser()
            if p.is_dir(): src_dir = p; g = list(p.glob("*.ovpn")); src_ovpn = g[0] if g else None
            elif p.suffix == ".ovpn": src_ovpn = p; src_dir = p.parent
        else:
            d = find_profile_dir()
            if d: src_dir = d; g = list(d.glob("*.ovpn")); src_ovpn = g[0] if g else None
        if not src_ovpn or not src_ovpn.exists():
            die("No encontre tu perfil .ovpn.\n"
                "  - Con WatchGuard instalado (Mac/Win):  usm-vpn setup\n"
                "  - Sin WatchGuard (Linux, etc.):        usm-vpn setup --download\n"
                "  - Con un .ovpn a mano:                 usm-vpn setup --profile <ruta>")
        if src_ovpn.resolve() != (PROF/"client.ovpn").resolve():
            shutil.copy(src_ovpn, PROF / "client.ovpn")
        for ref in parse_refs(src_ovpn.read_text(errors="ignore")):
            rp = (src_dir / ref) if src_dir else Path(ref)
            if rp.exists() and rp.resolve() != (PROF/Path(ref).name).resolve():
                shutil.copy(rp, PROF / Path(ref).name)

    # quitar auth-user-pass interactivo (lo damos por archivo)
    txt = (PROF / "client.ovpn").read_text(errors="ignore")
    txt = re.sub(r'^\s*auth-user-pass\s*$', '# auth-user-pass (via cmdline)', txt, flags=re.M)
    txt = re.sub(r'^\s*max-routes\b.*$', '# max-routes (obsoleta en OpenVPN 2.4+)', txt, flags=re.M)
    (PROF / "client.ovpn").write_text(txt)

    m = re.search(r'^\s*remote\s+(\S+)', txt, re.M)
    server = server_arg or (m.group(1) if m else DEFAULT_SERVER)

    ovpn = ovpn_arg or find_openvpn()
    cfg = {"server": server, "realm": realm, "openvpn": ovpn}
    CFG.write_text(json.dumps(cfg, indent=2))
    print(f"✅ Configurado.  Servidor: {server}   Realm: {realm}")
    print(f"   openvpn: {ovpn or 'NO ENCONTRADO — instalalo (ver: usm-vpn info)'}")
    if ovpn == WG_OPENVPN:
        print("   ⚠️  Estas usando el openvpn de WatchGuard. Para independizarte del todo:")
        print("       macOS: brew install openvpn   (luego repite: usm-vpn setup)")
    if IS_MAC and shutil.which("swiftc") and (RT/'saml-login.swift').exists():
        try:
            subprocess.run(["swiftc","-O",str(RT/'saml-login.swift'),"-o",str(RT/'saml-login')],check=True)
            print("   modo --gui disponible (Mac).")
        except Exception: pass

# ---------------- TOKEN (login SAML) ----------------
def get_token_paste(server):
    url = f"https://{server}/auth/saml/login?from=sslvpn_client"
    print("="*62); print(" LOGIN SAML — USM VPN"); print("="*62)
    print("\n 1) Se abrira tu navegador. Haz login + MFA.")
    print(" 2) Al terminar llegaras a una pagina de exito: copia la URL")
    print("    COMPLETA de la barra de direcciones (contiene 'token=') y pegala.\n")
    try: webbrowser.open(url)
    except Exception: pass
    print(f"    (Si no se abrio solo:  {url} )\n")
    pasted = input(" URL de exito (o token) > ").strip()
    tok = TOKRE.search(pasted); tok = tok.group(0) if tok else None
    um = re.search(r'user=([^&]+)', pasted); user = urllib.parse.unquote(um.group(1)) if um else None
    if tok and not user:
        user = input(" Tu correo (usuario@usm.cl): ").strip()
    return user, tok

def get_token_gui(server):
    helper = RT / "saml-login"
    if not helper.exists(): die("Modo --gui no disponible aqui. Usa el modo normal (pegar URL).")
    url = f"https://{server}/auth/saml/login?from=sslvpn_client"
    out = RUN / "cred.tmp"
    r = subprocess.run([str(helper), str(out), url, "sslvpn_success.shtml"])
    if r.returncode != 0 or not out.exists(): die("Login cancelado o fallido.")
    d = dict(l.split("=",1) for l in out.read_text().splitlines() if "=" in l)
    try: out.unlink()
    except Exception: pass
    return d.get("USER"), d.get("TOKEN")

# ---------------- CONNECT / DISCONNECT / STATUS ----------------
def is_running():
    if not PIDF.exists(): return None
    try: pid = int(PIDF.read_text().strip())
    except Exception: return None
    try:
        if IS_WIN:
            out = subprocess.run(["tasklist","/FI",f"PID eq {pid}"],capture_output=True,text=True).stdout
            return pid if str(pid) in out else None
        os.kill(pid, 0); return pid
    except PermissionError: return pid   # existe pero es de root: cuenta como activo
    except Exception: return None

def cmd_connect(args):
    cfg = load_cfg()
    if _all_pids():                       # deteccion robusta (pgrep + pidfile): NO matar a ciegas
        print("Ya hay una conexion (o un tunel previo) activa.")
        print("Usa:  usm-vpn reconnect   (reconectar)   o   usm-vpn disconnect")
        return
    if not cfg.get("openvpn"): die("No hay openvpn configurado. Instalalo y repite setup (ver: usm-vpn info).")
    mode = args[0] if args else ""
    user, tok = (get_token_gui if mode=="--gui" else get_token_paste)(cfg["server"])
    if not (user and tok): die("No obtuve usuario/token.")
    print(f">> Credenciales listas para {user} (token {tok[:10]}...).")

    auth = RUN / "auth.tmp"
    auth.write_text(f'{cfg["realm"]}\\{user}\n{tok}\n')
    try: os.chmod(auth, 0o600)
    except Exception: pass

    # limpiar log/pid previos (pueden haber quedado como root de una conexion anterior)
    if not IS_WIN and os.geteuid() != 0:
        subprocess.run(["sudo", "rm", "-f", str(LOG), str(PIDF)])
    else:
        for f in (LOG, PIDF):
            try: f.unlink()
            except Exception: pass
    cmd = [cfg["openvpn"], "--config", "client.ovpn", "--auth-user-pass", str(auth),
           "--auth-retry", "nointeract",
           "--log", str(LOG), "--writepid", str(PIDF)]
    if _ovpn_version(cfg["openvpn"]) >= (2, 5):   # 2.5+ ignora 'cipher'; reactivamos CBC
        cmd += ["--data-ciphers", "AES-256-CBC:AES-256-GCM:AES-128-GCM"]
    print(">> Levantando el tunel" + ("" if IS_WIN else " (puede pedir tu contraseña de sudo)") + "...")
    if IS_WIN:
        subprocess.Popen(cmd, cwd=str(PROF), creationflags=0x00000008)  # DETACHED_PROCESS
    else:
        cmd += ["--daemon"]                       # openvpn se va a background tras arrancar
        if os.geteuid() != 0: cmd = ["sudo"] + cmd  # sudo pide contraseña en la terminal
        subprocess.run(cmd, cwd=str(PROF))
        # openvpn crea log/pid como root; hazlos legibles para poder monitorizar
        if os.geteuid() != 0:
            time.sleep(1)
            subprocess.run(["sudo", "chmod", "644", str(LOG), str(PIDF)],
                           stderr=subprocess.DEVNULL)

    def _log():
        try: return LOG.read_text(errors="ignore")
        except Exception: return ""
    def _mark_readable():
        if not IS_WIN and os.geteuid() != 0:
            subprocess.run(["sudo","chmod","644",str(PIDF),str(LOG)],stderr=subprocess.DEVNULL)
    print(" Conectando", end="", flush=True)
    ok = False
    for _ in range(45):
        time.sleep(1); print(".", end="", flush=True)
        t = _log()
        if "Initialization Sequence Completed" in t:
            ok = True; break
        if re.search(r"AUTH_FAILED|Exiting due to fatal|TLS Error|Cannot resolve", t):
            print("\n❌ Fallo:\n" + "\n".join(t.splitlines()[-6:]))
            try: auth.unlink()
            except Exception: pass
            sys.exit(1)
    if not ok:                       # pudo completar justo al final
        time.sleep(1)
        if _all_pids() and "Initialization Sequence Completed" in _log():
            ok = True
    if ok:
        _mark_readable()
        dns_set(_pushed_dns(_log()))
        print("\n✅ CONECTADO.")
        return
    print("\n⚠️ Timeout. Ultimas lineas del log:\n" + "\n".join(_log().splitlines()[-8:]))

def _ovpn_version(path):
    try:
        out = subprocess.run([path,"--version"],capture_output=True,text=True).stdout
        m = re.search(r'OpenVPN (\d+)\.(\d+)', out)
        if m: return (int(m.group(1)), int(m.group(2)))
    except Exception: pass
    return (0,0)

def _ovpn_pids():
    """PIDs de openvpn que usan NUESTRO perfil (client.ovpn)."""
    pids = set()
    try:
        if IS_WIN:
            out = subprocess.run(["wmic","process","where","name=\'openvpn.exe\'",
                                  "get","ProcessId,CommandLine","/format:csv"],
                                 capture_output=True, text=True).stdout
            for line in out.splitlines():
                if "client.ovpn" in line:
                    tail = line.strip().split(",")[-1]
                    if tail.isdigit(): pids.add(int(tail))
        else:
            out = subprocess.run(["pgrep","-f","client.ovpn"],capture_output=True,text=True).stdout
            for l in out.split():
                if l.strip().isdigit(): pids.add(int(l))
    except Exception: pass
    return pids

def _kill(pid, force=False):
    try:
        if IS_WIN:
            subprocess.run(["taskkill","/PID",str(pid)]+(["/F"] if force else []),capture_output=True)
        elif os.geteuid()==0:
            os.kill(pid, signal.SIGKILL if force else signal.SIGTERM)
        else:
            subprocess.run(["sudo","kill","-9" if force else "-15",str(pid)])
    except Exception: pass

def _last_vpn_ip():
    try:
        m = re.findall(r'ifconfig\s+\S+\s+([0-9.]+)', LOG.read_text(errors="ignore"))
        return m[-1] if m else ""
    except Exception: return ""

def _route_sweep(vpn_ip):
    """Solo tras un cierre forzado: quita la ruta /24 del pool (POSIX)."""
    if IS_WIN or not vpn_ip: return
    net = ".".join(vpn_ip.split(".")[:3]) + ".0/24"
    try:
        if IS_MAC: subprocess.run(["sudo","route","-n","delete","-net",net],capture_output=True)
        else:      subprocess.run(["sudo","ip","route","del",net],capture_output=True)
    except Exception: pass

def _all_pids():
    s = _ovpn_pids(); r = is_running()
    if r: s.add(r)
    return s

def cmd_disconnect(args):
    pids = _all_pids()
    if not pids:
        print("No hay conexion activa.")
        dns_restore()
        try: PIDF.unlink()
        except Exception: pass
        return
    print(">> Cerrando tunel (limpio)...")
    for p in pids: _kill(p, force=False)      # SIGTERM: openvpn limpia rutas/interfaz solo
    gone = False
    for _ in range(6):
        time.sleep(1)
        if not _all_pids(): gone = True; break
    if not gone:
        print("   (no cerro solo; forzando y barriendo restos)")
        ip = _last_vpn_ip()
        for p in _all_pids(): _kill(p, force=True)
        time.sleep(1); _route_sweep(ip)
    dns_restore()
    for f in (PIDF, RUN / "auth.tmp"):
        try: f.unlink()
        except Exception: pass
    print(">> Desconectado.")

def cmd_reconnect(args):
    cmd_disconnect([]); time.sleep(1); cmd_connect(args)

def cmd_clean(args):
    """Barrido de emergencia (equivalente al watchdog): mata huerfanos y limpia restos."""
    pids = _all_pids()
    if pids:
        print(f">> Limpiando {len(pids)} proceso(s)...")
        ip = _last_vpn_ip()
        for p in pids: _kill(p, force=True)
        time.sleep(1); _route_sweep(ip)
    else:
        print("Nada que limpiar.")
    dns_restore()
    for f in (PIDF, RUN / "auth.tmp"):
        try: f.unlink()
        except Exception: pass
    print(">> Limpio.")

def cmd_status(args):
    cfg = CFG.exists() and json.loads(CFG.read_text()) or {}
    pids = _all_pids()
    pid = min(pids) if pids else None
    if pid:
        ip = ""
        try:
            m = re.findall(r'ifconfig\s+\S+\s+([0-9.]+)', LOG.read_text(errors="ignore"))
            if m: ip = m[-1]
        except Exception: pass
        print(f"🟢 CONECTADO  (pid {pid})")
        print(f"   Servidor: {cfg.get('server','?')}")
        if ip: print(f"   IP VPN:   {ip}")
    else:
        print("🔴 DESCONECTADO")

def cmd_info(args):
    cfg = CFG.exists() and json.loads(CFG.read_text()) or {}
    print("USM VPN — info")
    print(f"  SO:        {platform.system()} {platform.machine()}")
    print(f"  Servidor:  {cfg.get('server','(sin setup)')}")
    print(f"  Realm:     {cfg.get('realm','?')}")
    print(f"  openvpn:   {cfg.get('openvpn') or '(no encontrado)'}")
    print(f"  Perfil:    {PROF if PROF.exists() else '(sin setup)'}")
    print("\n  Requisito por SO para instalar openvpn:")
    print("    macOS:   brew install openvpn   (o usa el de WatchGuard)")
    print("    Linux:   sudo apt install openvpn   /   sudo dnf install openvpn")
    print("    Windows: winget install OpenVPN.OpenVPN  (ejecuta la terminal como Administrador)")
    print("\n  Perfil: si NO tienes WatchGuard (Linux), descarga el tuyo con:")
    print("          usm-vpn setup --download        (hara login SAML y lo baja del Firebox)")

def cmd_uninstall(args):
    yes = ("--yes" in args) or ("-y" in args)
    if not yes:
        try:
            r = input("Esto desconectara la VPN y borrara ~/.usm-vpn (incluye TUS certificados). "
                      "¿Seguro? [y/N] ").strip().lower()
        except EOFError:
            r = "n"
        if r not in ("y","yes","s","si"):
            print("Cancelado."); return
    print(">> Desconectando (si hay conexion)...")
    try: cmd_disconnect(["--quiet"])
    except Exception: pass
    if not IS_WIN:
        for link in ("/usr/local/bin/usm-vpn", str(HOME/".local/bin/usm-vpn")):
            lp = Path(link)
            try:
                if lp.is_symlink() or lp.exists():
                    if os.access(lp.parent, os.W_OK): lp.unlink()
                    else: subprocess.run(["sudo","rm","-f",str(lp)])
                    print("   enlace quitado:", link)
            except Exception: pass
    shutil.rmtree(RT, ignore_errors=True)
    print("   borrado:", RT)
    print(">> usm-vpn desinstalado. (Si clonaste el repo, borra esa carpeta a mano.)")

def main():
    cmds = {"setup":cmd_setup,"connect":cmd_connect,"disconnect":cmd_disconnect,
            "reconnect":cmd_reconnect,"status":cmd_status,"info":cmd_info,"clean":cmd_clean,
            "uninstall":cmd_uninstall}
    if len(sys.argv) < 2 or sys.argv[1] not in cmds:
        print("Uso: usm-vpn {setup|connect|disconnect|reconnect|status|info|clean|uninstall}")
        print("     usm-vpn connect [--gui]        (--gui solo en Mac)")
        print("     usm-vpn reconnect [--gui]      desconecta y vuelve a conectar")
        print("     usm-vpn clean                  mata cualquier tunel huerfano (cierre de emergencia)")
        print("     usm-vpn uninstall [-y]         desconecta, quita el enlace y borra ~/.usm-vpn")
        print("     usm-vpn setup                  autodetecta perfil de WatchGuard (Mac/Win)")
        print("     usm-vpn setup --download [--gui]  descarga tu perfil via SAML (Linux/sin WatchGuard)")
        print("     usm-vpn setup --profile RUTA   usa un .ovpn que ya tengas")
        sys.exit(0 if len(sys.argv)<2 else 1)
    cmds[sys.argv[1]](sys.argv[2:])

if __name__ == "__main__":
    main()
